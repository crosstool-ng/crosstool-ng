index 743421768ea..47c2b0a74ab 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -608,6 +608,7 @@ sh[123456789lbe]*-*-* | sh-*-*)
 	;;
 v850*-*-*)
 	cpu_type=v850
+	extra_headers="v850_fxu.h"
 	;;
 tic6x-*-*)
 	cpu_type=c6x
