+  FXU_V4SF_V4SF_V4SF_INT,
+  FXU_V4SI_V4SI_V4SI_INT,
+  FXU_V4SF_V4SF_INT,
+  FXU_INT_V4SI_INT,
+  FXU_V4SF_V4SF_PCVOID_INT,
+  FXU_V4SF_PCVOID,
