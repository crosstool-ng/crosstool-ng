+++ b/gcc/testsuite/gcc.target/v850/g4mh2-no-strict-align.c
@@ -0,0 +1,5 @@
+/* { dg-do compile } */
+/* { dg-options "-mg4mh2 -mno-strict-align" } */
+/* { dg-error "'-mno-strict-align' is not supported with '-mg4mh2'" "" { target *-*-* } 0 } */
+
+int i;
diff --git a/gcc/testsuite/gcc.target/v850/g4mh2-none.c b/gcc/testsuite/gcc.target/v850/g4mh2-none.c
