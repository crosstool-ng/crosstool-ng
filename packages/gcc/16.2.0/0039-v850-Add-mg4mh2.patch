+/* { dg-skip-if "tests the code without -mg4" { *-*-* } { "-mg4" "-mg4mh2" } { "" } } */
 
 unsigned char c;
 short s;
diff --git a/gcc/testsuite/gcc.target/v850/clip-e3v5.c b/gcc/testsuite/gcc.target/v850/clip-e3v5.c
index 0a5a4e573be..5656bdd2730 100644
--- a/gcc/testsuite/gcc.target/v850/clip-e3v5.c
+++ b/gcc/testsuite/gcc.target/v850/clip-e3v5.c
@@ -1,6 +1,6 @@
 /* { dg-do compile } */
 /* { dg-options "-O2 -mv850e3v5" } */
-/* { dg-skip-if "tests the code without -mg4" { *-*-* } { "-mg4" } { "" } } */
+/* { dg-skip-if "tests the code without -mg4" { *-*-* } { "-mg4" "-mg4mh2" } { "" } } */
 
 int sb (int x) { return x > 127 ? 127 : x < -128 ? -128 : x; }
 unsigned ub (unsigned x) { return x > 255 ? 255 : x; }
diff --git a/gcc/testsuite/gcc.target/v850/g4-none.c b/gcc/testsuite/gcc.target/v850/g4-none.c
index e063d1f53ac..b556aca2345 100644
--- a/gcc/testsuite/gcc.target/v850/g4-none.c
+++ b/gcc/testsuite/gcc.target/v850/g4-none.c
@@ -1,6 +1,6 @@
 /* { dg-do preprocess } */
 /* { dg-options "-mv850e3v5" } */
-/* { dg-skip-if "tests the code without -mg4" { *-*-* } { "-mg4" } { "" } } */
+/* { dg-skip-if "tests the code without -mg4" { *-*-* } { "-mg4" "-mg4mh2" } { "" } } */
 
 #ifdef __V850_G4__
 #error __V850_G4__ without -mg4
diff --git a/gcc/testsuite/gcc.target/v850/g4mh2-asm.c b/gcc/testsuite/gcc.target/v850/g4mh2-asm.c
new file mode 100644
index 00000000000..236c9475b18
--- /dev/null
+++ b/gcc/testsuite/gcc.target/v850/g4mh2-asm.c
@@ -0,0 +1,8 @@
+/* { dg-do assemble } */
+/* { dg-options "-mg4mh2" } */
+
+void
+f (void)
+{
+  __asm__ volatile ("ldm.mp [r1], r2-r5\n\tstm.gsr [r6]\n\tclip.b r1, r2");
+}
