diff --git a/gcc/testsuite/gcc.target/v850/fxu-arg-const.c b/gcc/testsuite/gcc.target/v850/fxu-arg-const.c
new file mode 100644
index 00000000000..34653feaadb
--- /dev/null
+++ b/gcc/testsuite/gcc.target/v850/fxu-arg-const.c
@@ -0,0 +1,15 @@
+/* { dg-do compile } */
+/* { dg-options "-mfxu -O0" } */
+
+typedef float vf __attribute__ ((vector_size (16)));
+
+extern int g (vf);
+
+int
+f (void)
+{
+  return g ((vf) { 1.0f, 2.0f, 3.0f, 4.0f });
