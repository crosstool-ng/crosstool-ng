+ADJUST_ALIGNMENT (UDQ, TARGET_8BYTE_ALIGN ? 8 : 4);
+ADJUST_ALIGNMENT (UTQ, TARGET_8BYTE_ALIGN ? 8 : 4);
+ADJUST_ALIGNMENT (DA, TARGET_8BYTE_ALIGN ? 8 : 4);
+ADJUST_ALIGNMENT (TA, TARGET_8BYTE_ALIGN ? 8 : 4);
+ADJUST_ALIGNMENT (UDA, TARGET_8BYTE_ALIGN ? 8 : 4);
+ADJUST_ALIGNMENT (UTA, TARGET_8BYTE_ALIGN ? 8 : 4);
+ADJUST_ALIGNMENT (DF, TARGET_8BYTE_ALIGN ? 8 : 4);
diff --git a/gcc/config/v850/v850-protos.h b/gcc/config/v850/v850-protos.h
index 934d41f098f..8359e69074f 100644
--- a/gcc/config/v850/v850-protos.h
+++ b/gcc/config/v850/v850-protos.h
@@ -27,10 +27,14 @@ extern void   expand_epilogue               (void);
 extern int    v850_handle_pragma            (int (*)(void), void (*)(int), char *);
 extern int    compute_register_save_size    (long *);
 extern int    compute_frame_size            (poly_int64, long *);
+extern HOST_WIDE_INT v850_initial_elimination_offset (int, int);
