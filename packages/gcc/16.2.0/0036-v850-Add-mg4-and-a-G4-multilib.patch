From 3bea5d66bb9da2986d53e60494a5e0045e67ebcc Mon Sep 17 00:00:00 2001
From: Parthiban Nallathambi <parthiban@linumiz.com>
Date: Thu, 12 Nov 2026 22:42:25 +0530
Subject: [PATCH] v850: Add mg4 and a G4 multilib

Add the option for the RH850 G4 cores and pass it to the assembler.
Add a multilib built with it, since its libraries differ from the
V850E3V5 ones.

Signed-off-by: Parthiban Nallathambi <parthiban@linumiz.com>
---
 gcc/config/v850/t-v850                          | 4 ++++
 gcc/config/v850/v850.cc                         | 7 +++++++
 gcc/config/v850/v850.h                          | 7 ++++++-
 gcc/config/v850/v850.opt                        | 4 ++++
 gcc/config/v850/v850.opt.urls                   | 3 +++
 gcc/doc/invoke.texi                             | 9 ++++++++-
 gcc/testsuite/gcc.target/v850/atomic-e2v3.c     | 1 +
 gcc/testsuite/gcc.target/v850/atomic-lockfree.c | 1 +
 gcc/testsuite/gcc.target/v850/g4-asm.c          | 8 ++++++++
 gcc/testsuite/gcc.target/v850/g4-cpu.c          | 3 +++
 gcc/testsuite/gcc.target/v850/g4-none.c         | 7 +++++++
 gcc/testsuite/gcc.target/v850/g4-opt.c          | 6 ++++++
 gcc/testsuite/gcc.target/v850/isr-frame.c       | 2 +-
 13 files changed, 59 insertions(+), 3 deletions(-)
 create mode 100644 gcc/testsuite/gcc.target/v850/g4-asm.c
 create mode 100644 gcc/testsuite/gcc.target/v850/g4-cpu.c
 create mode 100644 gcc/testsuite/gcc.target/v850/g4-none.c
 create mode 100644 gcc/testsuite/gcc.target/v850/g4-opt.c

diff --git a/gcc/config/v850/t-v850 b/gcc/config/v850/t-v850
index 9d44710c502..1391183307b 100644
--- a/gcc/config/v850/t-v850
+++ b/gcc/config/v850/t-v850
@@ -23,6 +23,10 @@ MULTILIB_DIRNAMES =  gcc-abi  soft-float
 MULTILIB_OPTIONS  += mv850e3v5
 MULTILIB_DIRNAMES +=  v850e3v5
 
+MULTILIB_OPTIONS  += mg4
+MULTILIB_DIRNAMES +=  g4
+MULTILIB_EXCEPTIONS = mg4 mgcc-abi/mg4 msoft-float/mg4 mgcc-abi/msoft-float/mg4
+
 TCFLAGS = -mno-app-regs -msmall-sld -Wa,-mwarn-signed-overflow -Wa,-mwarn-unsigned-overflow
 
 v850-c.o: $(srcdir)/config/v850/v850-c.cc $(CONFIG_H) $(SYSTEM_H) coretypes.h \
diff --git a/gcc/config/v850/v850.cc b/gcc/config/v850/v850.cc
index 41ac70fb8a4..2357302ef97 100644
--- a/gcc/config/v850/v850.cc
+++ b/gcc/config/v850/v850.cc
@@ -3236,6 +3236,13 @@ v850_option_override (void)
   if (! TARGET_GCC_ABI && small_memory_max[(int) SMALL_MEMORY_TDA] > 0)
     error ("%<-mtda%> is not supported with the RH850 ABI; use %<-mgcc-abi%>");
 
+  if (TARGET_G4 && ! TARGET_V850E3V5)
+    {
+      if (target_flags & MASK_CPU)
+	error ("%<-mg4%> requires %<-mv850e3v5%>");
+      target_flags |= MASK_V850E3V5;
+    }
+
   /* Save the initial options in case the user does function specific
      options.  */
   target_option_default_node = target_option_current_node
diff --git a/gcc/config/v850/v850.h b/gcc/config/v850/v850.h
index 86bee21b6a8..be074b41fb2 100644
--- a/gcc/config/v850/v850.h
+++ b/gcc/config/v850/v850.h
@@ -110,7 +110,10 @@
 %{m8byte-align:-m8byte-align} \
 %{msoft-float:-msoft-float} \
 %{mhard-float:-mhard-float} \
-%{mgcc-abi:-mgcc-abi}"
+%{mgcc-abi:-mgcc-abi} \
+%{mg4:-mg4}"
+
+#define DRIVER_SELF_SPECS "%{mg4:%{!mv*:-mv850e3v5}}"
 
 #define LINK_SPEC "%{mgcc-abi:-m v850}"
 
@@ -151,6 +154,8 @@
 	builtin_define ("__V850_CALLT__");	\
       if (TARGET_8BYTE_ALIGN)			\
 	builtin_define ("__V850_8BYTE_ALIGN__");\
+      if (TARGET_G4)				\
+	builtin_define ("__V850_G4__");		\
       builtin_define (TARGET_USE_FPU ?		\
 		      "__FPU_OK__" : "__NO_FPU__");\
     }						\
diff --git a/gcc/config/v850/v850.opt b/gcc/config/v850/v850.opt
index ef18945d1e0..b0d91bcf93d 100644
--- a/gcc/config/v850/v850.opt
+++ b/gcc/config/v850/v850.opt
@@ -125,6 +125,10 @@ mloop
 Target Mask(LOOP)
 Enable v850e3v5 loop instructions.
 
+mg4
+Target Mask(G4)
+Enable the RH850 G4 instructions.
+
 mzda=
 Target RejectNegative Joined UInteger
 Set the max size of data eligible for the ZDA area.
diff --git a/gcc/config/v850/v850.opt.urls b/gcc/config/v850/v850.opt.urls
index 3773ae09339..3c9738deee2 100644
--- a/gcc/config/v850/v850.opt.urls
+++ b/gcc/config/v850/v850.opt.urls
@@ -68,6 +68,9 @@ UrlSuffix(gcc/V850-Options.html#index-mv850e2v4)
 mloop
 UrlSuffix(gcc/V850-Options.html#index-mloop-1)
 
+mg4
+UrlSuffix(gcc/V850-Options.html#index-mg4)
+
 mzda=
 UrlSuffix(gcc/V850-Options.html#index-mzda)
 
diff --git a/gcc/doc/invoke.texi b/gcc/doc/invoke.texi
index 620e689faf8..ad25f50066b 100644
--- a/gcc/doc/invoke.texi
+++ b/gcc/doc/invoke.texi
@@ -1495,7 +1495,7 @@ See RS/6000 and PowerPC Options.
 -mv850  -mv850e3v5  -m850e2v4  -mv850e2v3
 -mv850e2  -mv850e1  -mv850es  -mv850e
 -mdisable-callt  -mrelax  -mlong-jumps
--msoft-float  -mhard-float  -mloop
+-msoft-float  -mhard-float  -mloop  -mg4
 -mrh850-abi  -mghs  -mgcc-abi
 -m8byte-align  -mbig-switch  -mapp-regs  -msmall-sld
 -mno-strict-align  -mjump-tables-in-data-section}
@@ -34515,6 +34515,13 @@ Enables the use of the e3v5 LOOP instruction.  The use of this
 instruction is not enabled by default when the e3v5 architecture is
 selected because its use is still experimental.
 
+@opindex mg4
+@item -mg4
+Enables the instructions of the RH850 G4 cores (G4KH, G4MH) on top of
+the v850e3v5 architecture, and passes @option{-mg4} to the assembler.
+It implies @option{-mv850e3v5}.  The preprocessor constant
+@code{__V850_G4__} is defined if this option is used.
+
 @opindex mrh850-abi
 @opindex mghs
 @item -mrh850-abi
diff --git a/gcc/testsuite/gcc.target/v850/atomic-e2v3.c b/gcc/testsuite/gcc.target/v850/atomic-e2v3.c
index a619808aa7f..a62c73c9dc4 100644
--- a/gcc/testsuite/gcc.target/v850/atomic-e2v3.c
+++ b/gcc/testsuite/gcc.target/v850/atomic-e2v3.c
@@ -1,5 +1,6 @@
 /* { dg-do compile } */
 /* { dg-options "-O2 -mv850e2v3" } */
+/* { dg-skip-if "tests the code without -mg4" { *-*-* } { "-mg4" } { "" } } */
 
 int v;
 
diff --git a/gcc/testsuite/gcc.target/v850/atomic-lockfree.c b/gcc/testsuite/gcc.target/v850/atomic-lockfree.c
index 5e74b3ae9a3..abd58645300 100644
--- a/gcc/testsuite/gcc.target/v850/atomic-lockfree.c
+++ b/gcc/testsuite/gcc.target/v850/atomic-lockfree.c
@@ -1,5 +1,6 @@
 /* { dg-do preprocess } */
 /* { dg-options "-mv850e3v5" } */
+/* { dg-skip-if "tests the code without -mg4" { *-*-* } { "-mg4" } { "" } } */
 
 #if __GCC_ATOMIC_INT_LOCK_FREE != 2 || __GCC_ATOMIC_LONG_LOCK_FREE != 2 \
     || __GCC_ATOMIC_POINTER_LOCK_FREE != 2
diff --git a/gcc/testsuite/gcc.target/v850/g4-asm.c b/gcc/testsuite/gcc.target/v850/g4-asm.c
new file mode 100644
index 00000000000..b7e590182ed
--- /dev/null
+++ b/gcc/testsuite/gcc.target/v850/g4-asm.c
@@ -0,0 +1,8 @@
+/* { dg-do assemble } */
+/* { dg-options "-mg4" } */
+
+void
+f (void)
+{
+  __asm__ volatile ("clip.b r1, r2");
+}
diff --git a/gcc/testsuite/gcc.target/v850/g4-cpu.c b/gcc/testsuite/gcc.target/v850/g4-cpu.c
new file mode 100644
index 00000000000..f1b2e04d46c
--- /dev/null
+++ b/gcc/testsuite/gcc.target/v850/g4-cpu.c
@@ -0,0 +1,3 @@
+/* { dg-do compile } */
+/* { dg-options "-mv850e2 -mg4" } */
+/* { dg-error "requires" "" { target *-*-* } 0 } */
diff --git a/gcc/testsuite/gcc.target/v850/g4-none.c b/gcc/testsuite/gcc.target/v850/g4-none.c
new file mode 100644
index 00000000000..e063d1f53ac
--- /dev/null
+++ b/gcc/testsuite/gcc.target/v850/g4-none.c
@@ -0,0 +1,7 @@
+/* { dg-do preprocess } */
+/* { dg-options "-mv850e3v5" } */
+/* { dg-skip-if "tests the code without -mg4" { *-*-* } { "-mg4" } { "" } } */
+
+#ifdef __V850_G4__
+#error __V850_G4__ without -mg4
+#endif
diff --git a/gcc/testsuite/gcc.target/v850/g4-opt.c b/gcc/testsuite/gcc.target/v850/g4-opt.c
new file mode 100644
index 00000000000..d2995b0076b
--- /dev/null
+++ b/gcc/testsuite/gcc.target/v850/g4-opt.c
@@ -0,0 +1,6 @@
+/* { dg-do preprocess } */
+/* { dg-options "-mg4" } */
+
+#if !defined __V850_G4__ || !defined __v850e3v5__
+#error -mg4 does not imply v850e3v5
+#endif
diff --git a/gcc/testsuite/gcc.target/v850/isr-frame.c b/gcc/testsuite/gcc.target/v850/isr-frame.c
index 3c65ab85fb9..584f2e23242 100644
--- a/gcc/testsuite/gcc.target/v850/isr-frame.c
+++ b/gcc/testsuite/gcc.target/v850/isr-frame.c
@@ -1,6 +1,6 @@
 /* { dg-do compile } */
 /* { dg-options "-O2" } */
-/* { dg-skip-if "tests the base targets" { *-*-* } { "-mv850e3v5" } { "" } } */
+/* { dg-skip-if "tests the base targets" { *-*-* } { "-mg4" "-mv850e3v5" } { "" } } */
 
 volatile int v;
 
-- 
Parthiban N

