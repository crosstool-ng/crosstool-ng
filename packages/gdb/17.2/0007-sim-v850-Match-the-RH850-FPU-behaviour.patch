 sim/testsuite/v850/fpu-fs.cgs       |  83 +++++++
 sim/testsuite/v850/fpu-nan.cgs      |  41 ++++
 sim/testsuite/v850/fpu-negabs.cgs   |  26 +++
 sim/testsuite/v850/fpu-rm.cgs       |  24 ++
 sim/testsuite/v850/fpu-snan-abs.cgs |  19 ++
 sim/testsuite/v850/fpu-sreg.cgs     |  19 ++
 sim/v850/simops.c                   | 243 +++++++++++++++----
