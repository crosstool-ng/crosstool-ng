diff --git a/sim/testsuite/v850/fpu-flags.cgs b/sim/testsuite/v850/fpu-flags.cgs
new file mode 100644
index 00000000000..d0d2f233319
--- /dev/null
+++ b/sim/testsuite/v850/fpu-flags.cgs
@@ -0,0 +1,52 @@
+# v850 FPSR.XP after FP instructions with the exceptions disabled, and the
+# sign of an exact zero sum when rounding toward -inf
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	.macro	xp fpsr op r_a r_b want
+	seti	\fpsr, r20
+	ldsr	r20, 6, 0
+	seti	\r_a, r1
+	seti	\r_b, r2
+	\op	r2, r1, r3
+	stsr	6, r21, 0
+	andi	0x1f, r21, r21
+	reg	r21, \want
+	.endm
+
+# inexact: 1 + 2^-30
+	xp	0x00020000, addf.s, 0x3f800000, 0x30800000, 0x01
+# invalid: 0 / 0
+	xp	0x00020000, divf.s, 0x00000000, 0x00000000, 0x10
+# divide by zero: 1 / 0
+	xp	0x00020000, divf.s, 0x3f800000, 0x00000000, 0x08
+# overflow and inexact: 2^100 * 2^100
+	xp	0x00020000, mulf.s, 0x71800000, 0x71800000, 0x05
+# exact: 1 + 1
+	xp	0x00020000, addf.s, 0x3f800000, 0x3f800000, 0x00
+# XP is sticky
+	seti	0x00020001, r20
+	ldsr	r20, 6, 0
+	addf.s	r1, r1, r3
+	stsr	6, r21, 0
+	andi	0x1f, r21, r21
+	reg	r21, 0x01
+
+# 1 - 1 is -0 when rounding toward -inf and +0 otherwise
+	seti	0x3f800000, r1
+	seti	0x000e0000, r20
+	ldsr	r20, 6, 0
+	subf.s	r1, r1, r3
+	reg	r3, 0x80000000
+	seti	0xbf800000, r2
+	addf.s	r2, r1, r3
+	reg	r3, 0x80000000
+	seti	0x00020000, r20
+	ldsr	r20, 6, 0
+	subf.s	r1, r1, r3
+	reg	r3, 0x00000000
+	addf.s	r2, r1, r3
+	reg	r3, 0x00000000
+
+	pass
diff --git a/sim/testsuite/v850/fpu-fma.cgs b/sim/testsuite/v850/fpu-fma.cgs
new file mode 100644
index 00000000000..55ff6828d83
--- /dev/null
+++ b/sim/testsuite/v850/fpu-fma.cgs
@@ -0,0 +1,21 @@
+# v850 fused multiply-add rounds the exact result once, to single
+# precision, (1 + 2^-12)^2 + 2^-56 is just above a tie and rounds up,
+# rounding through double first would give the even value.
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	seti	0x00020000, r20
+	ldsr	r20, 6, 0
+
+	seti	0x3f800800, r1
+	seti	0x3f800800, r2
+	seti	0x23800000, r3
+	fmaf.s	r1, r2, r3
+	reg	r3, 0x3f801001
+
+	seti	0xa3800000, r3
+	fmsf.s	r1, r2, r3
+	reg	r3, 0x3f801001
+
+	pass
diff --git a/sim/testsuite/v850/fpu-fs.cgs b/sim/testsuite/v850/fpu-fs.cgs
new file mode 100644
index 00000000000..23fafdbc6b8
--- /dev/null
+++ b/sim/testsuite/v850/fpu-fs.cgs
@@ -0,0 +1,83 @@
+# v850 FPSR.FS flush of subnormal operands and results
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	.macro	fpsr val
+	seti	\val, r20
+	ldsr	r20, 6, 0
+	.endm
+
+	.macro	fpsr_if exp
+	stsr	6, r20, 0
+	seti	0x00400000, r21
+	and	r21, r20
+	reg	r20, \exp
+	.endm
+
+	seti	0x3f800000, r1
+
+# Input operand: +-subnormal becomes +-0 and sets FPSR.IF
+	fpsr	0x00020000
+	seti	0x00000001, r2
+	mulf.s	r1, r2, r3
+	reg	r3, 0
+	fpsr_if	0x00400000
+	fpsr	0x00020000
+	seti	0x80000001, r2
+	mulf.s	r1, r2, r3
+	reg	r3, 0x80000000
+
+# ABSF.S does not flush its operand
+	seti	0x80000001, r2
+	absf.s	r2, r3
+	reg	r3, 0x00000001
+
+# Result: 2^-100 * 2^-30 is subnormal before rounding
+	seti	0x0d800000, r4
+	seti	0x30800000, r5
+	seti	0x8d800000, r6
+
+	fpsr	0x00020000
+	mulf.s	r4, r5, r3
+	reg	r3, 0
+	fpsr_if	0
+	fpsr	0x00060000
+	mulf.s	r4, r5, r3
+	reg	r3, 0
+	fpsr	0x000a0000
+	mulf.s	r4, r5, r3
+	reg	r3, 0x00800000
+	mulf.s	r6, r5, r3
+	reg	r3, 0x80000000
+	fpsr	0x000e0000
+	mulf.s	r4, r5, r3
+	reg	r3, 0
+	mulf.s	r6, r5, r3
+	reg	r3, 0x80800000
+
+# RN with FN: 1.5 * 2^-127 goes to 2^-126, 2^-130 to 0
+	seti	0x20400000, r7
+	seti	0x1f800000, r8
+	fpsr	0x00820000
+	mulf.s	r7, r8, r3
+	reg	r3, 0x00800000
+	mulf.s	r4, r5, r3
+	reg	r3, 0
+
+# Double: 2^-600 * 2^-500 is flushed to +0
+	mov	0, r10
+	seti	0x1a700000, r11
+	mov	0, r12
+	seti	0x20b00000, r13
+	fpsr	0x00020000
+	mulf.d	r10, r12, r14
+	reg	r14, 0
+	reg	r15, 0
+
+# FS = 0 keeps the subnormal result
+	fpsr	0x00000000
+	mulf.s	r4, r5, r3
+	reg	r3, 0x00080000
+
+	pass
diff --git a/sim/testsuite/v850/fpu-nan.cgs b/sim/testsuite/v850/fpu-nan.cgs
new file mode 100644
index 00000000000..ffbdad41f67
--- /dev/null
+++ b/sim/testsuite/v850/fpu-nan.cgs
@@ -0,0 +1,41 @@
+# v850 FPU NaN results, default NaN and QNaN priority reg2, reg1, reg3
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	.macro	op2 insn r_1 r_2 want
+	seti	\r_1, r1
+	seti	\r_2, r2
+	\insn	r1, r2, r3
+	reg	r3, \want
+	.endm
+
+	seti	0x00020000, r20
+	ldsr	r20, 6, 0
+# invalid operation on numbers
+	op2	divf.s, 0x00000000, 0x00000000, 0x7fffffff
+	op2	mulf.s, 0x00000000, 0x7f800000, 0x7fffffff
+# SNaN
+	op2	addf.s, 0x3f800000, 0x7f812345, 0x7fffffff
+	op2	addf.s, 0x7fc12345, 0x7f812345, 0x7fffffff
+# QNaN, reg2 first, then reg1
+	op2	addf.s, 0xffc54321, 0x7fc12345, 0x7fc12345
+	op2	addf.s, 0x7fc12345, 0xffc54321, 0xffc54321
+	op2	subf.s, 0x3f800000, 0x7fc12345, 0x7fc12345
+# MAXF and MINF with one QNaN give the number
+	op2	maxf.s, 0x7fc12345, 0x40000000, 0x40000000
+	op2	minf.s, 0x40000000, 0xffc54321, 0x40000000
+# FMAF takes the reg3 QNaN last
+	seti	0x3f800000, r1
+	seti	0x3f800000, r2
+	seti	0xffc54321, r3
+	fmaf.s	r1, r2, r3
+	reg	r3, 0xffc54321
+# double default NaN
+	seti	0, r6
+	seti	0, r7
+	divf.d	r6, r6, r8
+	reg	r8, 0xffffffff
+	reg	r9, 0x7fffffff
+
+	pass
diff --git a/sim/testsuite/v850/fpu-negabs.cgs b/sim/testsuite/v850/fpu-negabs.cgs
new file mode 100644
index 00000000000..124fe133f34
--- /dev/null
+++ b/sim/testsuite/v850/fpu-negabs.cgs
@@ -0,0 +1,26 @@
+# v850 negf and absf of a NaN change only the sign bit
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	seti	0x00020000, r20
+	ldsr	r20, 6, 0
+
+	seti	0x7fc00001, r1
+	negf.s	r1, r3
+	reg	r3, 0xffc00001
+	seti	0xffc00001, r1
+	absf.s	r1, r3
+	reg	r3, 0x7fc00001
+
+	seti	0x00000001, r4
+	seti	0x7ff80000, r5
+	negf.d	r4, r6
+	reg	r7, 0xfff80000
+	reg	r6, 0x00000001
+	seti	0xfff80000, r5
+	absf.d	r4, r6
+	reg	r7, 0x7ff80000
+	reg	r6, 0x00000001
+
+	pass
diff --git a/sim/testsuite/v850/fpu-rm.cgs b/sim/testsuite/v850/fpu-rm.cgs
new file mode 100644
index 00000000000..1f5751ddb44
--- /dev/null
+++ b/sim/testsuite/v850/fpu-rm.cgs
@@ -0,0 +1,24 @@
+# v850 FPSR.RM rounding modes
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	.macro	fdiv rm r_pos r_neg
+	seti	\rm, r20
+	ldsr	r20, 6, 0
+	divf.s	r2, r1, r3
+	reg	r3, \r_pos
+	divf.s	r2, r4, r3
+	reg	r3, \r_neg
+	.endm
+
+	seti	0x3f800000, r1
+	seti	0x40400000, r2
+	seti	0xbf800000, r4
+
+	fdiv	0x00000000, 0x3eaaaaab, 0xbeaaaaab
+	fdiv	0x00040000, 0x3eaaaaaa, 0xbeaaaaaa
+	fdiv	0x00080000, 0x3eaaaaab, 0xbeaaaaaa
+	fdiv	0x000c0000, 0x3eaaaaaa, 0xbeaaaaab
+
+	pass
diff --git a/sim/testsuite/v850/fpu-snan-abs.cgs b/sim/testsuite/v850/fpu-snan-abs.cgs
new file mode 100644
index 00000000000..c66eb22409a
--- /dev/null
+++ b/sim/testsuite/v850/fpu-snan-abs.cgs
@@ -0,0 +1,19 @@
+# v850 absf and negf of a signaling NaN raise no invalid operation,
+# also with the exceptions enabled
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	seti	0x000203e0, r20
+	ldsr	r20, 6, 0
+
+	seti	0x7f800001, r1
+	absf.s	r1, r3
+	reg	r3, 0x7f800001
+	negf.s	r1, r3
+	reg	r3, 0xff800001
+	stsr	6, r21, 0
+	andi	0x3ff, r21, r21
+	reg	r21, 0x3e0
+
+	pass
diff --git a/sim/testsuite/v850/fpu-sreg.cgs b/sim/testsuite/v850/fpu-sreg.cgs
new file mode 100644
index 00000000000..f73c133ae4d
--- /dev/null
+++ b/sim/testsuite/v850/fpu-sreg.cgs
@@ -0,0 +1,19 @@
+# v850e3v5 ldsr and stsr reach the FPU system registers at selID 0
+# without BSEL, FPCFG shows the FPSR.RM written through FPSR
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	seti	0x000e0000, r20
+	ldsr	r20, 6, 0
+	stsr	6, r21, 0
+	reg	r21, 0x000e0000
+	stsr	10, r22, 0
+	reg	r22, 0x00000180
+
+	seti	0x00020000, r20
+	ldsr	r20, 6, 0
+	stsr	10, r22, 0
+	reg	r22, 0x00000000
+
+	pass
diff --git a/sim/v850/simops.c b/sim/v850/simops.c
index e2799af80e1..1e725ca1226 100644
--- a/sim/v850/simops.c
+++ b/sim/v850/simops.c
@@ -2804,25 +2804,175 @@ OP_307E0 (void)
   sim_fpu_status_denorm = 16384,				----U (sim spec.)
 */  
     
+static int fpu_input_flushed;
+
 void
-update_fpsr (SIM_DESC sd, sim_fpu_status status, unsigned int mask, unsigned int double_op_p)
+v850_fpu_32to (sim_fpu *f, uint32_t s)
+{
+  SIM_DESC sd = simulator;
+
+  sim_fpu_32to (f, s);
+  if ((FPSR & FPSR_FS) && sim_fpu_is_denorm (f))
+    {
+      sim_fpu_32to (f, s & 0x80000000);
+      FPSR |= FPSR_IF;
+      fpu_input_flushed = 1;
+    }
+}
+
+void
+v850_fpu_232to (sim_fpu *f, uint32_t h, uint32_t l)
+{
+  SIM_DESC sd = simulator;
+
+  sim_fpu_232to (f, h, l);
+  if ((FPSR & FPSR_FS) && sim_fpu_is_denorm (f))
+    {
+      sim_fpu_232to (f, h & 0x80000000, 0);
+      FPSR |= FPSR_IF;
+      fpu_input_flushed = 1;
+    }
+}
+
+static int
+v850_fpu_flush_result (sim_fpu *f, sim_fpu_round round, int double_p)
+{
+  SIM_DESC sd = simulator;
+  int emin = double_p ? -1022 : -126;
+  int to_min;
+
+  if (!(FPSR & FPSR_FS)
+      || f->class != sim_fpu_class_number
+      || f->normal_exp >= emin)
+    return 0;
+
+  switch (round)
+    {
+    case sim_fpu_round_up:
+      to_min = !f->sign;
+      break;
+    case sim_fpu_round_down:
+      to_min = f->sign;
+      break;
+    case sim_fpu_round_near:
+      to_min = (FPSR & FPSR_FN) && f->normal_exp == emin - 1;
+      break;
+    default:
+      to_min = 0;
+      break;
+    }
+
+  if (double_p)
+    sim_fpu_232to (f, ((f->sign ? 0x80000000 : 0)
+		       | (to_min ? 0x00100000 : 0)), 0);
+  else
+    sim_fpu_32to (f, (f->sign ? 0x80000000 : 0) | (to_min ? 0x00800000 : 0));
+  return sim_fpu_status_underflow | sim_fpu_status_inexact;
+}
+
+int
+v850_fpu_round_32 (sim_fpu *f, sim_fpu_round round, sim_fpu_denorm denorm)
+{
+  int status = v850_fpu_flush_result (f, round, 0);
+
+  return status ? status : sim_fpu_round_32 (f, round, denorm);
+}
+
+int
+v850_fpu_round_64 (sim_fpu *f, sim_fpu_round round, sim_fpu_denorm denorm)
+{
+  int status = v850_fpu_flush_result (f, round, 1);
+
+  return status ? status : sim_fpu_round_64 (f, round, denorm);
+}
+
+/* Give an exact zero result of L + R, or of L - R when SUB_P, the sign
+   that IEEE 754 defines: the common sign of two zeros of the same sign,
+   else -0 when ROUND is toward -inf and +0 otherwise.  */
+
+void
+v850_fpu_sum_zero (sim_fpu *ans, const sim_fpu *l, const sim_fpu *r,
+		   int sub_p, sim_fpu_status status, sim_fpu_round round)
 {
-  unsigned int fpsr = FPSR & mask;
+  int rsign = r->sign ^ (sub_p != 0);
+
+  if (!sim_fpu_is_zero (ans)
+      || (status & (sim_fpu_status_inexact | sim_fpu_status_rounded
+		    | sim_fpu_status_underflow)))
+    return;
+  if (sim_fpu_is_zero (l) && sim_fpu_is_zero (r) && l->sign == rsign)
+    ans->sign = l->sign;
+  else
+    ans->sign = round == sim_fpu_round_down;
+}
 
-  unsigned int flags = 0;
+/* Return 0 for a number, 1 for a QNaN and 2 for an SNaN.  */
 
-  if (fpsr & FPSR_XEI
-      && ((status & (sim_fpu_status_rounded
-		     | sim_fpu_status_overflow
-		     | sim_fpu_status_inexact))
-	  || (status & sim_fpu_status_underflow
-	      && (fpsr & (FPSR_XEU | FPSR_XEI)) == 0
-	      && fpsr & FPSR_FS)))
+static int
+v850_nan_class (uint64_t x, int double_p)
+{
+  if (double_p)
     {
-      flags |= FPSR_XCI | FPSR_XPI;
+      if ((x & 0x7ff0000000000000ULL) != 0x7ff0000000000000ULL
+	  || (x & 0x000fffffffffffffULL) == 0)
+	return 0;
+      return (x & 0x0008000000000000ULL) ? 1 : 2;
     }
+  if ((x & 0x7f800000) != 0x7f800000 || (x & 0x007fffff) == 0)
+    return 0;
+  return (x & 0x00400000) ? 1 : 2;
+}
+
 
-  if (fpsr & FPSR_XEV
+void
+v850_fpu_nan_result (sim_fpu *ans, int out_double_p, int in_double_p, int n,
+		     const uint64_t *ops)
+{
+  int i, q = -1;
+
+  if (!sim_fpu_is_nan (ans))
+    return;
+  for (i = 0; i < n; i++)
+    {
+      int c = v850_nan_class (ops[i], in_double_p);
+
+      if (c == 2)
+	{
+	  q = -2;
+	  break;
+	}
+      if (c == 1 && q == -1)
+	q = i;
+    }
+  if (q >= 0)
+    {
+      if (in_double_p && out_double_p)
+	sim_fpu_232to (ans, ops[q] >> 32, ops[q] & 0xffffffff);
+      else if (!in_double_p && !out_double_p)
+	sim_fpu_32to (ans, ops[q]);
+      return;
+    }
+  if (out_double_p)
+    sim_fpu_232to (ans, 0x7fffffff, 0xffffffff);
+  else
+    sim_fpu_32to (ans, 0x7fffffff);
+}
+
+void
+update_fpsr (SIM_DESC sd, sim_fpu_status status, unsigned int mask, unsigned int double_op_p)
+{
+  unsigned int causes = 0;
+
+  if (fpu_input_flushed
+      && !(status & (sim_fpu_status_invalid_snan | sim_fpu_status_invalid_isi
+		     | sim_fpu_status_invalid_idi | sim_fpu_status_invalid_zdz
+		     | sim_fpu_status_invalid_imz | sim_fpu_status_invalid_cvi
+		     | sim_fpu_status_invalid_div0
+		     | sim_fpu_status_invalid_sqrt)))
+    status |= sim_fpu_status_inexact;
+  fpu_input_flushed = 0;
+
+  if ((mask & FPSR_XEV)
       && (status & (sim_fpu_status_invalid_isi
 		    | sim_fpu_status_invalid_imz
 		    | sim_fpu_status_invalid_zdz
@@ -2830,36 +2980,48 @@ update_fpsr (SIM_DESC sd, sim_fpu_status status, unsigned int mask, unsigned int
 		    | sim_fpu_status_invalid_cvi
 		    | sim_fpu_status_invalid_sqrt
 		    | sim_fpu_status_invalid_snan)))
-    {
-      flags |= FPSR_XCV | FPSR_XPV;
-    }
+    causes |= FPSR_XPV;
 
-  if (fpsr & FPSR_XEZ
+  if ((mask & FPSR_XEZ)
       && (status & sim_fpu_status_invalid_div0))
-    {
-      flags |= FPSR_XCV | FPSR_XPV;
-    }
+    causes |= FPSR_XPZ;
 
-  if (fpsr & FPSR_XEO
+  if ((mask & FPSR_XEO)
       && (status & sim_fpu_status_overflow))
-    {
-      flags |= FPSR_XCO | FPSR_XPO;
-    }
-      
-  if (((fpsr & FPSR_XEU) || (fpsr & FPSR_FS) == 0)
+    causes |= FPSR_XPO;
+
+  if ((mask & FPSR_XEU)
       && (status & (sim_fpu_status_underflow
 		    | sim_fpu_status_denorm)))
     {
-      flags |= FPSR_XCU | FPSR_XPU;
+      causes |= FPSR_XPU;
+      if ((FPSR & FPSR_FS) && !(FPSR & FPSR_XEU))
+	causes |= FPSR_XPI;
     }
 
-  if (flags)
-    {
-      FPSR &= ~FPSR_XC;
