 sim/v850/interp.c             |   3 +
 sim/v850/simops.c             |  82 ++++++++++++
 sim/v850/simops.h             |   4 +
 sim/v850/v850-sim.h           |  10 +-
 sim/v850/v850.igen            | 241 +++++++++++++++++++++++++++++++++-
 10 files changed, 709 insertions(+), 7 deletions(-)
