@@ -84,6 +84,10 @@ int v850_float_compare(SIM_DESC sd, int cmp, sim_fpu wop1, sim_fpu wop2, int dou
 /* MEMORY ACCESS */
 uint32_t load_data_mem(SIM_DESC sd, address_word addr, int len);
 void store_data_mem(SIM_DESC sd, address_word addr, int len, uint32_t data);
+void v850_link_set (uint32_t addr, int len);
+void v850_link_clear (void);
+int v850_link_check (uint32_t addr, int len);
+void v850_clip (int reg1, int reg2, int32_t min, int32_t max, int is_unsigned);
 
 unsigned long Add32 (unsigned long a1, unsigned long a2, int * carry);
 
diff --git a/sim/v850/v850-sim.h b/sim/v850/v850-sim.h
index f20875aea4f..318b476b65c 100644
--- a/sim/v850/v850-sim.h
+++ b/sim/v850/v850-sim.h
@@ -36,6 +36,9 @@ struct v850_sim_cpu {
   v850_regs reg;
   reg_t psw_mask;               /* only allow non-reserved bits to be set */
   sim_event *pending_nmi;
+  int link_valid;
+  int link_size;
+  reg_t link_addr;
 };
 
 #define V850_SIM_CPU(cpu) ((struct v850_sim_cpu *) CPU_ARCH_DATA (cpu))
@@ -393,9 +396,12 @@ sim_core_read_aligned_2 (STATE_CPU (SD, 0), \
 sim_core_read_unaligned_##LEN (STATE_CPU (simulator, 0), \
 			       PC, read_map, (ADDR))
 
+void v850_link_store (uint32_t addr, int len);
+
 #define store_mem(ADDR,LEN,DATA) \
-sim_core_write_unaligned_##LEN (STATE_CPU (simulator, 0), \
-				PC, write_map, (ADDR), (DATA))
+(v850_link_store ((ADDR), (LEN)), \
+ sim_core_write_unaligned_##LEN (STATE_CPU (simulator, 0), \
+				 PC, write_map, (ADDR), (DATA)))
 
 
 /* compare cccc field against PSW */
diff --git a/sim/v850/v850.igen b/sim/v850/v850.igen
index 836baf1649f..c9aef8ad9f1 100644
--- a/sim/v850/v850.igen
+++ b/sim/v850/v850.igen
@@ -291,6 +291,18 @@ rrrrr,11111100000 + wwwww,01101000000:XII:::bsw
 
 
 
+// CACHE
+111,pp,111111,RRRRR + PPPPP,00101100000:X:::cache
+*v850e3v5
+"cache <pp><PPPPP>, [r<reg1>]"
+{
+  TRACE_ALU_INPUT1 (GR[reg1]);
+  if (((pp << 5) | PPPPP) == 0x7e)
+    v850_link_clear ();
+}
+
+
+
 // CAXI
 rrrrr,111111,RRRRR + wwwww,00011101110:IX:::caxi
 *v850e2
@@ -340,6 +352,48 @@ rrrrr,111111,RRRRR + wwwww,00011101110:IX:::caxi
 }
 
 
+// CLIP.B
+rrrrr,111111,RRRRR + 0000000000001000:IX:::clip.b
+*v850e3v5
+"clip.b r<reg1>, r<reg2>"
+{
+  TRACE_ALU_INPUT1 (GR[reg1]);
+  v850_clip (reg1, reg2, -0x80, 0x7f, 0);
+  TRACE_ALU_RESULT1 (GR[reg2]);
+}
+
+// CLIP.BU
+rrrrr,111111,RRRRR + 0000000000001010:IX:::clip.bu
+*v850e3v5
+"clip.bu r<reg1>, r<reg2>"
+{
+  TRACE_ALU_INPUT1 (GR[reg1]);
+  v850_clip (reg1, reg2, 0, 0xff, 1);
+  TRACE_ALU_RESULT1 (GR[reg2]);
+}
+
+// CLIP.H
+rrrrr,111111,RRRRR + 0000000000001100:IX:::clip.h
+*v850e3v5
+"clip.h r<reg1>, r<reg2>"
+{
+  TRACE_ALU_INPUT1 (GR[reg1]);
+  v850_clip (reg1, reg2, -0x8000, 0x7fff, 0);
+  TRACE_ALU_RESULT1 (GR[reg2]);
+}
+
+// CLIP.HU
+rrrrr,111111,RRRRR + 0000000000001110:IX:::clip.hu
+*v850e3v5
+"clip.hu r<reg1>, r<reg2>"
