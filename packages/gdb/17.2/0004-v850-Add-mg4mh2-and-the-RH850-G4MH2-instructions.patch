+    { 316, "gmeiwr" },
+    { 317, "gmfewr" },
+    { 318, "gmpeid" },
+    { 352, "tscountl" },
+    { 353, "tscounth" },
+    { 354, "tsctrl" },
+    { 360, "pmumctrl" },
+    { 361, "pmgmctrl" },
+    { 384, "lstest0" },
+    { 385, "lstest1" },
+    { 386, "lscfg" },
+    { 389, "ifcr" },
+    { 392, "brpctrl0" },
+    { 428, "l1rcfg" },
+    { 440, "rdbcr" },
