+
+  for (i = 0; i < ARRAY_SIZE (v850_g4mh2_sreg_names); i++)
+    if (v850_g4mh2_sreg_names[i].value == reg)
+      return v850_g4mh2_sreg_names[i].name;
+  return NULL;
+}
+
 static const char *
 get_v850_sreg_name (unsigned int reg)
 {
@@ -542,13 +693,20 @@ disassemble (bfd_vma memaddr,
 		  info->fprintf_func (info->stream, ", [");
 		  square = true;
 		}
-	      else if (   (strcmp (op->name, "pushsp") == 0
+	      else if ((   (strcmp (op->name, "pushsp") == 0
 			|| strcmp (op->name, "popsp") == 0
-			|| strcmp (op->name, "dbpush" ) == 0)
+			|| strcmp (op->name, "dbpush" ) == 0
+			|| strcmp (op->name, "stm.mp") == 0)
 		       && opnum == 2)
+		       || (strcmp (op->name, "ldm.mp") == 0 && opnum == 3))
 		{
 		  info->fprintf_func (info->stream, "-");
 		}
+	      else if (strcmp (op->name, "stm.mp") == 0 && opnum == 3)
+		{
+		  info->fprintf_func (info->stream, ", %s[", prefix);
+		  square = true;
+		}
 	      else if (opnum > 1
 		       && (v850_operands[*(opindex_ptr - 1)].flags
 			   & V850_OPERAND_DISP) != 0
@@ -595,9 +753,12 @@ disassemble (bfd_vma memaddr,
 		  info->fprintf_func (info->stream, "ep");
 		  break;
 		case V850_OPERAND_SRG:
-		  if (v850_g4_sregs && info->mach == bfd_mach_v850e3v5)
+		  if ((v850_g4_sregs || v850_g4mh2_sregs)
+		      && info->mach == bfd_mach_v850e3v5)
 		    {
-		      const char *name = get_v850_g4_sreg_name (value);
+		      const char *name = (v850_g4mh2_sregs
+					  ? get_v850_g4mh2_sreg_name (value)
+					  : get_v850_g4_sreg_name (value));
 
 		      if (name != NULL)
 			info->fprintf_func (info->stream, "%s", name);
@@ -771,11 +932,14 @@ print_insn_v850 (bfd_vma memaddr, struct disassemble_info * info)
   const char *opt;
 
   v850_g4_sregs = false;
+  v850_g4mh2_sregs = false;
   if (info->disassembler_options != NULL)
     FOR_EACH_DISASSEMBLER_OPTION (opt, info->disassembler_options)
       {
 	if (disassembler_options_cmp (opt, "g4") == 0)
 	  v850_g4_sregs = true;
+	else if (disassembler_options_cmp (opt, "g4mh2") == 0)
+	  v850_g4mh2_sregs = true;
 	else
 	  /* xgettext:c-format */
 	  opcodes_error_handler (_("unrecognised disassembler option: %s"),
@@ -989,4 +1153,5 @@ print_v850_disassembler_options (FILE *stream)
 The following V850 specific disassembler options are supported for use\n\
 with the -M switch:\n"));
   fprintf (stream, _("  g4  Print RH850 G4 system register names.\n"));
+  fprintf (stream, _("  g4mh2  Print RH850 G4MH2 system register names.\n"));
 }
diff --git a/opcodes/v850-opc.c b/opcodes/v850-opc.c
index 82c266f9bb1..dec87134d29 100644
--- a/opcodes/v850-opc.c
+++ b/opcodes/v850-opc.c
@@ -1601,6 +1601,9 @@ const struct v850_opcode v850_opcodes[] =
 { "ldl.hu",	two (0x0fe0, 0x0374),	two (0xffe0, 0x07ff),	{R1, R3},		1, PROCESSOR_V850E3V5_UP | PROCESSOR_OPTION_G4 },
 { "ldl.w",	two (0x07e0, 0x0378),	two (0xffe0, 0x07ff),	{R1, R3}, 		1, PROCESSOR_V850E3V5_UP },
 
+{ "ldm.gsr",	two (0x07e0, 0x9960),	two (0xffe0, 0xffff),	{R1},			1, PROCESSOR_V850E3V5_UP | PROCESSOR_OPTION_G4MH2 },
+{ "ldm.mp",	two (0x07e0, 0x0166),	two (0x07e0, 0x07ff),	{R1, R2, R3},		1, PROCESSOR_V850E3V5_UP | PROCESSOR_OPTION_G4MH2 },
+
 { "ldsr",	two (0x07e0, 0x0020),	two (0x07e0, 0x07ff),	{R1, SR2, SELID}, 	0, PROCESSOR_V850E3V5_UP },
 { "ldsr",	two (0x07e0, 0x0020),	two (0x07e0, 0x07ff),	{R1, SR2}, 		0, PROCESSOR_V850E3V5_UP },
 { "ldsr",	two (0x07e0, 0x0020),	two (0x07e0, 0x07ff),	{R1, OLDSR2}, 		0, (PROCESSOR_ALL & (~ PROCESSOR_V850E3V5_UP)) },
@@ -1761,6 +1764,9 @@ const struct v850_opcode v850_opcodes[] =
 { "stc.h",	two (0x07e0, 0x0376),	two (0xffe0, 0x07ff),	{R3, R1},		2, PROCESSOR_V850E3V5_UP | PROCESSOR_OPTION_G4 },
 { "stc.w",	two (0x07e0, 0x037a),	two (0xffe0, 0x07ff),	{R3, R1},		2, PROCESSOR_V850E3V5_UP },
 
+{ "stm.gsr",	two (0x07e0, 0x9160),	two (0xffe0, 0xffff),	{R1},			1, PROCESSOR_V850E3V5_UP | PROCESSOR_OPTION_G4MH2 },
+{ "stm.mp",	two (0x07e0, 0x0164),	two (0x07e0, 0x07ff),	{R2, R3, R1},		3, PROCESSOR_V850E3V5_UP | PROCESSOR_OPTION_G4MH2 },
+
 { "stsr",	two (0x07e0, 0x0040),	two (0x07e0, 0x07ff),	{SR1, R2, SELID}, 	0, PROCESSOR_V850E3V5_UP },
 { "stsr",	two (0x07e0, 0x0040),	two (0x07e0, 0x07ff),	{SR1, R2}, 		0, PROCESSOR_V850E3V5_UP },
 { "stsr",	two (0x07e0, 0x0040),	two (0x07e0, 0x07ff),	{OLDSR1, R2}, 		0, (PROCESSOR_ALL & (~ PROCESSOR_V850E3V5_UP)) },
