+{
+  static const struct
+  {
+    unsigned int value;
+    const char *name;
+  } v850_g4mh2_sreg_names[] =
+  {
+    {   0, "eipc" },
+    {   1, "eipsw" },
+    {   2, "fepc" },
+    {   3, "fepsw" },
+    {   5, "psw" },
+    {   6, "fpsr" },
+    {   7, "fpepc" },
+    {   8, "fpst" },
+    {   9, "fpcc" },
+    {  10, "fpcfg" },
+    {  13, "eiic" },
+    {  14, "feic" },
+    {  15, "pswh" },
+    {  16, "ctpc" },
+    {  17, "ctpsw" },
+    {  18, "eipswh" },
+    {  19, "fepswh" },
+    {  20, "ctbp" },
+    {  21, "snzcfg" },
+    {  28, "eiwr" },
+    {  29, "fewr" },
+    {  32, "spid" },
+    {  33, "spidlist" },
+    {  34, "rbase" },
+    {  35, "ebase" },
+    {  36, "intbp" },
+    {  37, "mctl" },
+    {  38, "pid" },
+    {  40, "svlock" },
+    {  43, "sccfg" },
+    {  44, "scbp" },
+    {  48, "hvcfg" },
+    {  49, "gmcfg" },
+    {  52, "hvsb" },
+    {  64, "peid" },
+    {  65, "bmid" },
+    {  70, "mea" },
+    {  72, "mei" },
+    {  74, "ispr" },
+    {  75, "imsr" },
+    {  76, "icsr" },
+    {  77, "intcfg" },
+    {  78, "plmr" },
+    {  79, "rbcr0" },
+    {  80, "rbcr1" },
+    {  81, "rbnr" },
+    {  82, "rbip" },
+    {  96, "dbgen" },
+    { 144, "ictagl" },
+    { 145, "ictagh" },
+    { 146, "icdatl" },
+    { 147, "icdath" },
+    { 152, "icctrl" },
+    { 154, "iccfg" },
+    { 156, "icerr" },
+    { 160, "mpm" },
+    { 162, "mpcfg" },
+    { 168, "mca" },
+    { 169, "mcs" },
+    { 170, "mcc" },
+    { 171, "mcr" },
+    { 172, "mci" },
+    { 176, "mpidx" },
+    { 177, "mpbk" },
+    { 180, "mpla" },
+    { 181, "mpua" },
+    { 182, "mpat" },
+    { 184, "mpid0" },
+    { 185, "mpid1" },
+    { 186, "mpid2" },
+    { 187, "mpid3" },
+    { 188, "mpid4" },
+    { 189, "mpid5" },
+    { 190, "mpid6" },
+    { 191, "mpid7" },
+    { 288, "gmeipc" },
