+/* Return the RH850 G4 name table selected with "set disassembler-options".  */
+
+static const v850_sreg_row *
+v850_g4_sreg_names_table ()
+{
+  const char *opt = v850_disassembler_options.c_str ();
+  const v850_sreg_row *names = NULL;
+
+  while (*opt != '\0')
+    {
+      size_t len = strcspn (opt, ",");
+
+      if (len == 5 && strncmp (opt, "g4mh2", 5) == 0)
+	names = v850_g4mh2_sreg_names;
+      else if (len == 2 && strncmp (opt, "g4", 2) == 0 && names == NULL)
+	names = v850_g4_sreg_names;
+      opt += len;
+      if (*opt == ',')
+	opt++;
+    }
+  return names;
+}
