+/* Implement the "register_name" gdbarch method for v850e3v5.  */
+
+static const char *
+v850e3v5_register_name (struct gdbarch *gdbarch, int regnum)
+{
+  const v850_sreg_row *g4_names = v850_g4_sreg_names_table ();
+
+  if (g4_names != NULL
+      && regnum >= E_SR0_REGNUM && regnum < E_PC_REGNUM)
+    return g4_names[0][regnum - E_SR0_REGNUM];
+  if (g4_names != NULL
+      && regnum >= E_SELID_1_R0_REGNUM && regnum <= E_SELID_7_R31_REGNUM)
+    return g4_names[1 + (regnum - E_SELID_1_R0_REGNUM) / 32]
+		   [(regnum - E_SELID_1_R0_REGNUM) % 32];
 
   static_assert (E_NUM_OF_V850E3V5_REGS
 		     == ARRAY_SIZE (v850e3v5_reg_names));
@@ -494,6 +637,62 @@ v850_register_type (struct gdbarch *gdbarch, int regnum)
   return builtin_type (gdbarch)->builtin_int32;
 }
 
+static const char *
+v850_tdesc_register_name (struct gdbarch *gdbarch, int regnum)
+{
+  if (regnum < E_NUM_OF_V850E3V5_REGS)
+    return v850e3v5_register_name (gdbarch, regnum);
+  return tdesc_register_name (gdbarch, regnum);
+}
+
+static struct type *
+v850_tdesc_register_type (struct gdbarch *gdbarch, int regnum)
+{
+  if (regnum < E_NUM_OF_V850E3V5_REGS)
+    return v850_register_type (gdbarch, regnum);
+  return tdesc_register_type (gdbarch, regnum);
+}
+
+/* GCC numbers wr0-wr31 as DWARF registers 36-67.  */
+
+static int
+v850_dwarf2_reg_to_regnum (struct gdbarch *gdbarch, int reg)
+{
+  if (reg >= 36 && reg <= 67)
+    {
+      std::string name = string_printf ("wr%d", reg - 36);
+      return user_reg_map_name_to_regnum (gdbarch, name.c_str (), -1);
+    }
+  return reg;
+}
+
+static void
+v850_use_tdesc (struct gdbarch *gdbarch, const struct target_desc *tdesc)
+{
+  const struct tdesc_feature *feature
+    = tdesc_find_feature (tdesc, "org.gnu.gdb.v850.core");
+  if (feature == NULL)
+    return;
+
+  tdesc_arch_data_up tdesc_data = tdesc_data_alloc ();
+  int valid = 1;
+  for (int i = 0; i < E_NUM_OF_V850E3V5_REGS; i++)
+    {
+      std::string name = (v850e3v5_reg_names[i][0] != '\0'
+			  ? std::string (v850e3v5_reg_names[i])
+			  : string_printf ("unused%d", i));
+      valid &= tdesc_numbered_register (feature, tdesc_data.get (), i,
+					name.c_str ());
+    }
+  if (!valid)
+    return;
+
+  tdesc_use_registers (gdbarch, tdesc, std::move (tdesc_data));
+  set_gdbarch_register_name (gdbarch, v850_tdesc_register_name);
+  set_gdbarch_register_type (gdbarch, v850_tdesc_register_type);
+  set_gdbarch_dwarf2_reg_to_regnum (gdbarch, v850_dwarf2_reg_to_regnum);
+}
