 		    int idx;
@@ -900,6 +967,11 @@ disassemble (bfd_vma memaddr,
 		  info->fprintf_func (info->stream, "%s", get_v850_vreg_name (value));
 		  break;
 
+		case V850_OPERAND_WREG:
+		  info->fprintf_func (info->stream, "%s",
+				      get_v850_wreg_name (value));
+		  break;
