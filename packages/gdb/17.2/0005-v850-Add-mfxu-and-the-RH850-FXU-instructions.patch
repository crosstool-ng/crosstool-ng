@@ -737,6 +797,8 @@ disassemble (bfd_vma memaddr,
 				       | V850E_OPERAND_REG_LIST
 				       | V850_OPERAND_CC
 				       | V850_OPERAND_VREG
+				       | V850_OPERAND_WREG
+				       | V850_OPERAND_FXCC
 				       | V850_OPERAND_CACHEOP
