+0x0+0010002 5f 12[ 	]+add[ 	]+-1, r2
+0x0+0010004 ea 07 05 01[ 	]+bne[ 	]+0x0+10108
+#...
+0x0+0210106 5f 22[ 	]+add[ 	]+-1, gp
+0x0+0210108 b2 05[ 	]+be[ 	]+0x0+21010e
