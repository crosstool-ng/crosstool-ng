From 38867f8666f5796e8e88511a5dbc4b796b6715f8 Mon Sep 17 00:00:00 2001
From: Parthiban Nallathambi <parthiban@linumiz.com>
Date: Fri, 13 Nov 2026 01:58:13 +0530
Subject: [PATCH] gas: v850: Check the range of branch displacements

A resolved PC relative branch was encoded without a range check, so a
far target silently wrapped. Report displacements that do not fit, and
relax an out of range loop to a 22 bit jump.

Signed-off-by: Parthiban Nallathambi <parthiban@linumiz.com>
---
 gas/config/tc-v850.c                    | 106 ++++++++++++++++++------
 gas/testsuite/gas/v850/basic.exp        |   4 +
 gas/testsuite/gas/v850/disp-range-bad.d |   3 +
 gas/testsuite/gas/v850/disp-range-bad.l |   7 ++
 gas/testsuite/gas/v850/disp-range-bad.s |  20 +++++
 gas/testsuite/gas/v850/disp-range.d     |  14 ++++
 gas/testsuite/gas/v850/disp-range.s     |  14 ++++
 gas/testsuite/gas/v850/loop-relax-bad.d |   3 +
 gas/testsuite/gas/v850/loop-relax-bad.l |   2 +
 gas/testsuite/gas/v850/loop-relax-bad.s |   5 ++
 gas/testsuite/gas/v850/loop-relax.d     |  16 ++++
 gas/testsuite/gas/v850/loop-relax.s     |  11 +++
 12 files changed, 179 insertions(+), 26 deletions(-)
 create mode 100644 gas/testsuite/gas/v850/disp-range-bad.d
 create mode 100644 gas/testsuite/gas/v850/disp-range-bad.l
 create mode 100644 gas/testsuite/gas/v850/disp-range-bad.s
 create mode 100644 gas/testsuite/gas/v850/disp-range.d
 create mode 100644 gas/testsuite/gas/v850/disp-range.s
 create mode 100644 gas/testsuite/gas/v850/loop-relax-bad.d
 create mode 100644 gas/testsuite/gas/v850/loop-relax-bad.l
 create mode 100644 gas/testsuite/gas/v850/loop-relax-bad.s
 create mode 100644 gas/testsuite/gas/v850/loop-relax.d
 create mode 100644 gas/testsuite/gas/v850/loop-relax.s

diff --git a/gas/config/tc-v850.c b/gas/config/tc-v850.c
index 4373bd3cd2a..216fea7b9c6 100644
--- a/gas/config/tc-v850.c
+++ b/gas/config/tc-v850.c
@@ -129,7 +129,8 @@ const relax_typeS md_relax_table[] =
   /* Loop.  (V850E2V4_UP, max 22-bit).  */
 #define SUBYPTE_LOOP_16_22	29
   {0x0, -0x0fffe, 4, SUBYPTE_LOOP_16_22 + 1},
-  {0x1ffffe + 2, -0x200000 + 2, 6, 0},
+  {0xfffe + 2, -0x10000 + 2, 6, SUBYPTE_LOOP_16_22 + 2},
+  {0x1ffffe + 4, -0x200000 + 4, 8, 0},
 };
 
 static int v850_relax = 0;
@@ -1671,6 +1672,21 @@ md_atof (int type, char *litp, int *sizep)
 
 /* Very gross.  */
 
+/* fix_new for md_convert_frag: give the fixup the source location of the
+   frag, the instruction it belongs to.  */
+
+static fixS *
+v850_fix_new (fragS *fragP, unsigned long where, unsigned long size,
+	      symbolS *sym, offsetT offset, int pcrel,
+	      bfd_reloc_code_real_type r_type)
+{
+  fixS *fixP = fix_new (fragP, where, size, sym, offset, pcrel, r_type);
+
+  fixP->fx_file = fragP->fr_file;
+  fixP->fx_line = fragP->fr_line;
+  return fixP;
+}
+
 void
 md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
 		 asection *sec ATTRIBUTE_UNUSED,
@@ -1680,8 +1696,8 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
 
   if (fragP->fr_subtype == SUBYPTE_LOOP_16_22)
     {
-      fix_new (fragP, fragP->fr_fix, 4, fragP->fr_symbol,
-	       fragP->fr_offset, 1, BFD_RELOC_UNUSED + opindex);
+      v850_fix_new (fragP, fragP->fr_fix, 4, fragP->fr_symbol,
+		    fragP->fr_offset, 1, BFD_RELOC_UNUSED + opindex);
       fragP->fr_fix += 4;
     }
   else if (fragP->fr_subtype == SUBYPTE_LOOP_16_22 + 1)
@@ -1694,10 +1710,22 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
       /* Now create the conditional branch + fixup to the final target.  */
       /* 0x000107ea = bne LBL(disp17).  */
       md_number_to_chars (buffer + 2, 0x000107ea, 4);
-      fix_new (fragP, fragP->fr_fix + 2, 4, fragP->fr_symbol,
-	       fragP->fr_offset, 1, BFD_RELOC_V850_17_PCREL);
+      v850_fix_new (fragP, fragP->fr_fix + 2, 4, fragP->fr_symbol,
+		    fragP->fr_offset, 1, BFD_RELOC_V850_17_PCREL);
       fragP->fr_fix += 6;
     }
+  else if (fragP->fr_subtype == SUBYPTE_LOOP_16_22 + 2)
+    {
+      char *buffer = fragP->fr_literal + fragP->fr_fix;
+      int loop_reg = buffer[0] & 0x1f;
+
+      md_number_to_chars (buffer, 0x025f | (loop_reg << 11), 2);
+      md_number_to_chars (buffer + 2, 0x05b2, 2);
+      md_number_to_chars (buffer + 4, 0x00000780, 4);
+      v850_fix_new (fragP, fragP->fr_fix + 4, 4, fragP->fr_symbol,
+		    fragP->fr_offset, 1, BFD_RELOC_V850_22_PCREL);
+      fragP->fr_fix += 8;
+    }
   /* In range conditional or unconditional branch.  */
   else if (fragP->fr_subtype == SUBYPTE_COND_9_22
       || fragP->fr_subtype == SUBYPTE_UNCOND_9_22
@@ -1711,8 +1739,8 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
       || fragP->fr_subtype == SUBYPTE_SA_9_17_22_32)
 
     {
-      fix_new (fragP, fragP->fr_fix, 2, fragP->fr_symbol,
-	       fragP->fr_offset, 1, BFD_RELOC_UNUSED + opindex);
+      v850_fix_new (fragP, fragP->fr_fix, 2, fragP->fr_symbol,
+		    fragP->fr_offset, 1, BFD_RELOC_UNUSED + opindex);
       fragP->fr_fix += 2;
     }
   /* V850e2r-v3 17bit conditional branch.  */
@@ -1730,8 +1758,8 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
       /* Now create the unconditional branch + fixup to the final
 	 target.  */
       md_number_to_chars (buffer + 2, 0x0001, 2);
-      fix_new (fragP, fragP->fr_fix, 4, fragP->fr_symbol,
-	       fragP->fr_offset, 1, BFD_RELOC_V850_17_PCREL);
+      v850_fix_new (fragP, fragP->fr_fix, 4, fragP->fr_symbol,
+		    fragP->fr_offset, 1, BFD_RELOC_V850_17_PCREL);
       fragP->fr_fix += 4;
     }
   /* Out of range conditional branch.  Emit a branch around a 22bit jump.  */
@@ -1754,8 +1782,8 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
       /* Now create the unconditional branch + fixup to the final
 	 target.  */
       md_number_to_chars (buffer + 2, 0x00000780, 4);
-      fix_new (fragP, fragP->fr_fix + 2, 4, fragP->fr_symbol,
-	       fragP->fr_offset, 1, BFD_RELOC_V850_22_PCREL);
+      v850_fix_new (fragP, fragP->fr_fix + 2, 4, fragP->fr_symbol,
+		    fragP->fr_offset, 1, BFD_RELOC_V850_22_PCREL);
       fragP->fr_fix += 6;
     }
   /* Out of range conditional branch.  Emit a branch around a 32bit jump.  */
@@ -1776,8 +1804,8 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
       /* Now create the unconditional branch + fixup to the final
 	 target.  */
       md_number_to_chars (buffer + 2, 0x02e0, 2);
-      fix_new (fragP, fragP->fr_fix + 4, 4, fragP->fr_symbol,
-	       fragP->fr_offset + 2, 1, BFD_RELOC_V850_32_PCREL);
+      v850_fix_new (fragP, fragP->fr_fix + 4, 4, fragP->fr_symbol,
+		    fragP->fr_offset + 2, 1, BFD_RELOC_V850_32_PCREL);
       fragP->fr_fix += 8;
     }
   /* Out of range unconditional branch.  Emit a 22bit jump.  */
@@ -1785,16 +1813,16 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
 	   || fragP->fr_subtype == SUBYPTE_UNCOND_9_22_32 + 1)
     {
       md_number_to_chars (fragP->fr_fix + fragP->fr_literal, 0x00000780, 4);
-      fix_new (fragP, fragP->fr_fix, 4, fragP->fr_symbol,
-	       fragP->fr_offset, 1, BFD_RELOC_V850_22_PCREL);
+      v850_fix_new (fragP, fragP->fr_fix, 4, fragP->fr_symbol,
+		    fragP->fr_offset, 1, BFD_RELOC_V850_22_PCREL);
       fragP->fr_fix += 4;
     }
   /* Out of range unconditional branch.  Emit a 32bit jump.  */
   else if (fragP->fr_subtype == SUBYPTE_UNCOND_9_22_32 + 2)
     {
       md_number_to_chars (fragP->fr_fix + fragP->fr_literal, 0x02e0, 2);
-      fix_new (fragP, fragP->fr_fix + 4, 4, fragP->fr_symbol,
-	       fragP->fr_offset + 2, 1, BFD_RELOC_V850_32_PCREL);
+      v850_fix_new (fragP, fragP->fr_fix + 4, 4, fragP->fr_symbol,
+		    fragP->fr_offset + 2, 1, BFD_RELOC_V850_32_PCREL);
       fragP->fr_fix += 6;
     }
   /* Out of range SA conditional branch.  Emit a branch to a 22bit jump.  */
@@ -1817,8 +1845,8 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
 	 target.  */
       /* jr SYM */
       md_number_to_chars (buffer + 4, 0x00000780, 4);
-      fix_new (fragP, fragP->fr_fix + 4, 4, fragP->fr_symbol,
-	       fragP->fr_offset, 1, BFD_RELOC_V850_22_PCREL);
+      v850_fix_new (fragP, fragP->fr_fix + 4, 4, fragP->fr_symbol,
+		    fragP->fr_offset, 1, BFD_RELOC_V850_22_PCREL);
       fragP->fr_fix += 8;
     }
   /* Out of range SA conditional branch.  Emit a branch around a 32bit jump.  */
@@ -1839,8 +1867,8 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED,
 	 target.  */
       /* jr SYM */
       md_number_to_chars (buffer + 4, 0x02e0, 2);
-      fix_new (fragP, fragP->fr_fix + 6, 4, fragP->fr_symbol,
-	       fragP->fr_offset + 2, 1, BFD_RELOC_V850_32_PCREL);
+      v850_fix_new (fragP, fragP->fr_fix + 6, 4, fragP->fr_symbol,
+		    fragP->fr_offset + 2, 1, BFD_RELOC_V850_32_PCREL);
 
       fragP->fr_fix += 10;
     }
@@ -3045,7 +3073,7 @@ md_assemble (char *str)
 	  if (((processor_mask & PROCESSOR_V850E3V5_UP) == 0) || default_disp_size == 22)
 	    {
 	      insn_size = 4;
-	      f = frag_var (rs_machine_dependent, 6, 2, SUBYPTE_LOOP_16_22,
+	      f = frag_var (rs_machine_dependent, 8, 4, SUBYPTE_LOOP_16_22,
 			    fixups[0].exp.X_add_symbol,
 			    fixups[0].exp.X_add_number,
 			    (char *) (uintptr_t) fixups[0].opindex);
@@ -3382,6 +3410,19 @@ v850_pcrel_from_section (fixS *fixp, segT section)
   return fixp->fx_frag->fr_address + fixp->fx_where;
 }
 
+/* Report a resolved PC-relative displacement that does not fit in a
+   signed field of BITS bits.  */
+
+static void
+v850_check_pcrel_range (fixS *fixP, valueT value, int bits)
+{
+  valueT half = (valueT) 1 << (bits - 1);
+
+  if (value + half > 2 * half - 1)
+    as_bad_where (fixP->fx_file, fixP->fx_line,
+		  _("branch value out of range"));
+}
+
 void
 md_apply_fix (fixS *fixP, valueT *valueP, segT seg ATTRIBUTE_UNUSED)
 {
@@ -3445,10 +3486,20 @@ md_apply_fix (fixS *fixP, valueT *valueP, segT seg ATTRIBUTE_UNUSED)
       if (operand->flags & V850_INVERSE_PCREL)
 	value = - value;
 
-      insn = v850_insert_operand (insn, operand, (offsetT) value,
-				  &errmsg);
-      if (errmsg)
-	as_warn_where (fixP->fx_file, fixP->fx_line, "%s", errmsg);
+      if (fixP->fx_done && (operand->flags & V850_PCREL) != 0
+	  && operand->insert != NULL)
+	{
+	  insn = operand->insert (insn, (offsetT) value, &errmsg);
+	  if (errmsg)
+	    as_bad_where (fixP->fx_file, fixP->fx_line, "%s", errmsg);
+	}
+      else
+	{
+	  insn = v850_insert_operand (insn, operand, (offsetT) value,
+				      &errmsg);
+	  if (errmsg)
+	    as_warn_where (fixP->fx_file, fixP->fx_line, "%s", errmsg);
+	}
 
       if (fixP->fx_size > 2)
 	bfd_putl32 (insn, where);
@@ -3546,11 +3597,13 @@ md_apply_fix (fixS *fixP, valueT *valueP, segT seg ATTRIBUTE_UNUSED)
 	      break;
 
 	    case BFD_RELOC_V850_9_PCREL:
+	      v850_check_pcrel_range (fixP, value, 9);
 	      bfd_putl16 (((value & 0x1f0) << 7) | ((value & 0x0e) << 3)
 			  | (bfd_getl16 (where) & ~((0x1f0 << 7) | (0x0e << 3))), where);
 	      break;
 
 	    case BFD_RELOC_V850_17_PCREL:
+	      v850_check_pcrel_range (fixP, value, 17);
 	      bfd_putl32 (((value & 0x10000) >> (16 - 4)) | ((value & 0xfffe) << 16)
 			  | (bfd_getl32 (where) & ~((0x10000 >> (16 - 4)) | (0xfffe << 16))), where);
 	      break;
@@ -3561,6 +3614,7 @@ md_apply_fix (fixS *fixP, valueT *valueP, segT seg ATTRIBUTE_UNUSED)
 	      break;
 
 	    case BFD_RELOC_V850_22_PCREL:
+	      v850_check_pcrel_range (fixP, value, 22);
 	      bfd_putl32 (((value & 0xfffe) << 16) | ((value & 0x3f0000) >> 16)
 			  | (bfd_getl32 (where) & ~((0xfffe << 16) | (0x3f0000 >> 16))), where);
 	      break;
