+.*:18: Error: branch value out of range
diff --git a/gas/testsuite/gas/v850/disp-range-bad.s b/gas/testsuite/gas/v850/disp-range-bad.s
new file mode 100644
index 00000000000..a967b85d3fa
--- /dev/null
+++ b/gas/testsuite/gas/v850/disp-range-bad.s
@@ -0,0 +1,20 @@
+# Branch displacements one step beyond their fields.
+	.text
+	jr	1f
+	.skip	0x1ffffc
+1:	nop
+2:	nop
+	.skip	0x200000
+	jr	2b
+	jarl	3f, r31
+	.skip	0x1ffffc
+3:	nop
+	bne17	4f
+	.skip	0xfffc
+4:	nop
+	br	5f
+	.skip	0x200004
+5:	nop
+	bne	6f
+	.skip	0x200004
+6:	nop
diff --git a/gas/testsuite/gas/v850/disp-range.d b/gas/testsuite/gas/v850/disp-range.d
new file mode 100644
index 00000000000..ddbf40087e5
--- /dev/null
+++ b/gas/testsuite/gas/v850/disp-range.d
@@ -0,0 +1,14 @@
