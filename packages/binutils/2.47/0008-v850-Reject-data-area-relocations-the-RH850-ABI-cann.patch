+0000000c R_V850_ZDA_16_16_SPLIT_OFFSET  _z
+00000012 R_V850_SDA_16_16_OFFSET  _s
+00000014 R_V850_SDA_16_16_SPLIT_OFFSET  _s
+0000001a R_V850_TDA_16_16_OFFSET  _t
+0000001c R_V850_TDA_6_8_OFFSET  _t
+0000001e R_V850_TDA_6_8_OFFSET  _t
+00000020 R_V850_TDA_7_8_OFFSET  _t
+00000022 R_V850_TDA_7_7_OFFSET  _t
