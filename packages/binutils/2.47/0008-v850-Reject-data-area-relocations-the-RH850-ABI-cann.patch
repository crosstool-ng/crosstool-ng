diff --git a/gas/testsuite/gas/v850/rh850-da.s b/gas/testsuite/gas/v850/rh850-da.s
new file mode 100644
index 00000000000..fb4ae893143
--- /dev/null
+++ b/gas/testsuite/gas/v850/rh850-da.s
@@ -0,0 +1,7 @@
+# Data area relocations that the rh850 ABI supports.
+	.text
+	movea	zdaoff(_z), r0, r10
+	ld.w	sdaoff(_s)[gp], r11
+	st.w	r11, sdaoff(_s)[gp]
+	.data
+	.hword	zdaoff(_z)
