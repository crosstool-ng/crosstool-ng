diff --git a/gas/testsuite/gas/v850/rh850-da-bad.l b/gas/testsuite/gas/v850/rh850-da-bad.l
new file mode 100644
index 00000000000..5f12dad0ded
--- /dev/null
+++ b/gas/testsuite/gas/v850/rh850-da-bad.l
@@ -0,0 +1,17 @@
+.*: Assembler messages:
+.*:3: Error: ld.w zdaoff\(_z\)\[r0\],r10: zdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:4: Error: st.w r10,zdaoff\(_z\)\[r0\]: zdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:5: Error: ld.h zdaoff\(_z\)\[r0\],r10: zdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:6: Error: ld.bu zdaoff\(_z\)\[r0\],r10: zdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:7: Error: movea sdaoff\(_s\),gp,r10: sdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:8: Error: ld.bu sdaoff\(_s\)\[gp\],r10: sdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:9: Error: movea tdaoff\(_t\),ep,r10: tdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:10: Error: sld.w tdaoff\(_t\)\[ep\],r10: tdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:11: Error: sst.w r10,tdaoff\(_t\)\[ep\]: tdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:12: Error: sld.h tdaoff\(_t\)\[ep\],r10: tdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:13: Error: sld.b tdaoff\(_t\)\[ep\],r10: tdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:14: Error: sld.hu tdaoff\(_t\)\[ep\],r10: tdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:15: Error: sld.bu tdaoff\(_t\)\[ep\],r10: tdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:17: Error: sdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:18: Error: tdaoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
+.*:19: Error: ctoff\(\) is not supported by the rh850 ABI. Use -mgcc-abi instead
diff --git a/gas/testsuite/gas/v850/rh850-da-bad.s b/gas/testsuite/gas/v850/rh850-da-bad.s
new file mode 100644
index 00000000000..fa4e8431c88
--- /dev/null
+++ b/gas/testsuite/gas/v850/rh850-da-bad.s
@@ -0,0 +1,19 @@
+# Data area relocations that the rh850 ABI has no relocation for.
+	.text
+	ld.w	zdaoff(_z)[r0], r10
+	st.w	r10, zdaoff(_z)[r0]
+	ld.h	zdaoff(_z)[r0], r10
+	ld.bu	zdaoff(_z)[r0], r10
+	movea	sdaoff(_s), gp, r10
+	ld.bu	sdaoff(_s)[gp], r10
+	movea	tdaoff(_t), ep, r10
+	sld.w	tdaoff(_t)[ep], r10
+	sst.w	r10, tdaoff(_t)[ep]
+	sld.h	tdaoff(_t)[ep], r10
+	sld.b	tdaoff(_t)[ep], r10
+	sld.hu	tdaoff(_t)[ep], r10
+	sld.bu	tdaoff(_t)[ep], r10
+	.data
+	.hword	sdaoff(_s)
+	.hword	tdaoff(_t)
+	.hword	ctoff(_c)
