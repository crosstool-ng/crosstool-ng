+0x00000018 e1 17 aa 1d[ 	]+maxf\.s4[ 	]+.*
+0x0000001c ff 8f aa f5[ 	]+maxf\.s4[ 	]+.*
+0x00000020 e1 17 ac 1d[ 	]+minf\.s4[ 	]+.*
