+  { "lt",   0xc, PROCESSOR_V850E3V5_UP },
+  { "nge",  0xd, PROCESSOR_V850E3V5_UP },
+  { "ngl",  0xb, PROCESSOR_V850E3V5_UP },
+  { "ngle", 0x9, PROCESSOR_V850E3V5_UP },
+  { "ngt",  0xf, PROCESSOR_V850E3V5_UP },
+  { "ole",  0x6, PROCESSOR_V850E3V5_UP },
