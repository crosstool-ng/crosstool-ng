+set_fxu (int ignore ATTRIBUTE_UNUSED)
+{
+  processor_mask |= (PROCESSOR_OPTION_G4 | PROCESSOR_OPTION_G4MH2
+		     | PROCESSOR_OPTION_FXU);
+}
